# act configuration — local CI runner for .github/workflows/.
#
# Used by `make ci-local`. act bind-mounts this file when invoked from
# the repo root, so the flags below apply automatically.
#
# Platform pins:
#   ubuntu-latest → catthehacker/ubuntu:act-latest
#     The community-standard image for act. Includes node, sudo,
#     systemd-ish tooling, and the bits needed by
#     `cachix/install-nix-action`. ~17 GB on disk after first pull.
-P ubuntu-latest=catthehacker/ubuntu:act-latest

# Reuse a host-side action cache so re-runs don't re-fetch action
# tarballs each invocation. Lives under build/ so it's gitignored.
--action-cache-path build/.act-action-cache

# Reuse a host-side artifact location for upload-artifact steps so they
# don't fail with "Cannot connect to artifact endpoint" (the GitHub
# Actions runtime isn't available locally). Lives under build/.
--artifact-server-path build/.act-artifacts
